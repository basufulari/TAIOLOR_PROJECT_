PORT=5000

# MongoDB Atlas (required — all data saves to cloud)
USE_IN_MEMORY_DB=false
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ai_tailor?retryWrites=true&w=majority

# App mode: tailor-only registration & login

JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d
AI_SERVICE_URL=http://localhost:8000
UPLOAD_DIR=uploads
CLIENT_URL=http://localhost:8081

# Razorpay (online payments)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxx

# Local MongoDB (optional instead of Atlas):
# MONGODB_URI=mongodb://127.0.0.1:27017/ai_tailor

# In-memory dev (no Atlas):
# USE_IN_MEMORY_DB=true
